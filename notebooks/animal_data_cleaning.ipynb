!pip install word2number

import io
import re
import numpy as np
import pandas as pd
from google.colab import files
from word2number import w2n

# 1. Upload or read the already uploaded CSV
raw_filename = "Messy Animal Data - Animal Dataset (1).csv"
try:
    df = pd.read_csv(raw_filename)
except FileNotFoundError:
    print("Please upload the messy dataset:")
    uploaded = files.upload()
    raw_filename = next(iter(uploaded))
    df = pd.read_csv(io.BytesIO(uploaded[raw_filename]))

# 2. Inspect and match columns dynamically
print("Found columns:", list(df.columns))

name_col = next((c for c in df.columns if any(k in c.lower() for k in ["name", "animal", "species"])), None)
speed_col = next((c for c in df.columns if "speed" in c.lower()), None)
diet_col = next((c for c in df.columns if "diet" in c.lower()), None)

if not all([name_col, speed_col, diet_col]):
    raise ValueError(f"Could not map all columns automatically. Detected -> Name: '{name_col}', Speed: '{speed_col}', Diet: '{diet_col}'")

print(f"Mapping columns -> Name: '{name_col}', Speed: '{speed_col}', Diet: '{diet_col}'")

df = df[[name_col, speed_col, diet_col]].rename(columns={
    name_col: "name",
    speed_col: "speed",
    diet_col: "diet"
}).dropna()

# 3. Trim whitespace
df["name"] = df["name"].astype(str).str.strip()
df["diet"] = df["diet"].astype(str).str.strip().str.lower()
df["speed"] = df["speed"].astype(str).str.strip().str.lower()

# 4. Standardize diet values
def clean_diet(val):
    if "carn" in val:
        return "carnivore"
    if "herb" in val:
        return "herbivore"
    if "omni" in val:
        return "omnivore"
    return np.nan

df["diet"] = df["diet"].apply(clean_diet)

# 5. Clean speed numbers and word conversions
def clean_speed(val):
    val_clean = re.sub(r"[a-z/]+", "", val).strip()

    # Words to numbers
    text_words = [w for w in re.findall(r"[a-z]+", val) if w not in ["km", "h", "mph", "to", "and"]]
    if text_words:
        try:
            return float(w2n.word_to_num(" ".join(text_words)))
        except ValueError:
            pass

    # Ranges (e.g., 40-60 -> 50.0)
    range_match = re.search(r"(\d+(?:\.\d+)?)\s*-\s*(\d+(?:\.\d+)?)", val_clean)
    if range_match:
        return (float(range_match.group(1)) + float(range_match.group(2))) / 2.0

    # Direct number
    single_match = re.search(r"\d+(?:\.\d+)?", val_clean)
    if single_match:
        return float(single_match.group(0))

    return np.nan

df["speed"] = df["speed"].apply(clean_speed)

# 6. Drop invalid rows and export
df = df.dropna(subset=["name", "speed", "diet"])
df = df[df["speed"] > 0]

output_filename = "sample_animals.csv"
df.to_csv(output_filename, index=False)
print("Finished! Cleaned rows:", len(df))
files.download(output_filename)
